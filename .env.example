# ================================
# ENVIRONMENT CONFIGURATION
# ================================
ENVIRONMENT=development
SECRET_KEY=replace-with-a-strong-secret-key
ENCRYPTION_KEY=replace-with-your-fernet-encryption-key

# ================================
# DATABASE CONFIGURATION
# ================================

# Local (development - SQLite)
# DATABASE_URL=sqlite:///./carbon_tracker.db

# Production (PostgreSQL - Supabase / Cloud)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ================================
# API CONFIGURATION
# ================================
API_HOST=127.0.0.1
API_PORT=8000

# ================================
# CORS CONFIGURATION
# ================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# ================================
# STREAMLIT CONFIGURATION (OPTIONAL)
# ================================
# If deploying on Streamlit Cloud, also add DATABASE_URL
# inside `.streamlit/secrets.toml`

# ================================
# CLOUD PROVIDER CONFIGURATION (OPTIONAL)
# ================================

# AWS
AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_DEFAULT_REGION=us-east-1

# GCP
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Azure
# AZURE_STORAGE_CONNECTION_STRING=your-connection-string
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
# AZURE_TENANT_ID=your-tenant-id