# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database ---
# Local development default (sqlite:///carbon_tracker.db) works with no
# configuration. For production, point at PostgreSQL, e.g.:
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/carbon_tracker
DATABASE_URL=sqlite:///carbon_tracker.db

# --- Secrets (REQUIRED in production; the app runs with insecure fallbacks
# in local dev if these are unset, which is fine for `streamlit run app.py`
# on localhost but must never be relied on outside that) ---

# Fernet key used by utils/encryption.py to encrypt credentials at rest
# (e.g. connector API keys). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# JWT signing secret for api/routes/auth.py. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Streamlit session signing secret (app.py). Generate the same way as SECRET_KEY.
STREAMLIT_SESSION_SECRET=

# --- API server (main.py / FastAPI) ---
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# --- Optional: cloud connector credentials, only needed if you wire up
# live billing API pull (see docs/ROADMAP.md Phase 2) rather than the
# default configured-export-file connectors. ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=
# AZURE_STORAGE_CONNECTION_STRING=
